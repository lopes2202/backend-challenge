# Porta do servidor HTTP (NestJS)
PORT=3000

# PostgreSQL 16 (banco principal e pool de conexões)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wagering
DATABASE_POOL_MAX=30
# Banco isolado utilizado pela suíte de testes de integração (`bun test`)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/wagering_test

# AWS SQS via LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_ACCOUNT_ID=000000000000
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_DLQ_QUEUE=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo

# Workers em background (defina como "false" para desabilitar em processos específicos)
WORKER_SQS_CONSUMER_ENABLED=true
WORKER_OUTBOX_PUBLISHER_ENABLED=true
WORKER_PENDING_REFERENCE_ENABLED=true

# Parâmetros do consumidor SQS
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_MAX_RECEIVE_COUNT=5
SQS_WAIT_TIME_SECONDS=10
SQS_BATCH_SIZE=10
SQS_RETRY_VISIBILITY_BASE_SECONDS=2

# Parâmetros do publicador do Transactional Outbox (backoff exponencial)
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_MAX_MS=300000

# Parâmetros do worker de resolução fora de ordem (PENDING_REFERENCE)
PENDING_POLL_INTERVAL_MS=1000
PENDING_BATCH_SIZE=50
PENDING_TTL_SECONDS=300
PENDING_MAX_ATTEMPTS=10
PENDING_BACKOFF_BASE_MS=1000
PENDING_BACKOFF_MAX_MS=60000
